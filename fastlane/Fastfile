# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

require "tmpdir"
require "fileutils"

APP_STORE_RELEASE_NOTES = {
  "en-US" => "This release contains bug fixes, stability improvements, and functionality upgrades."
}.freeze

platform :ios do
  before_all do
    Dotenv.load ".env"
  end

  desc "Push a new release build to the App Store"

  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")
    )

    increment_build_number(xcodeproj: "Learner/Learner.xcodeproj")

    # Build the app using Gym (the recommended method)
    gym(
      project: "Learner/Learner.xcodeproj",
      scheme: "Learner",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic"
      }
    )

    # Set the changelog for the release
    # set_changelog(changelog: "This release contains bug fixes, stability improvements, and functionality upgrades.")

    # Upload the build to App Store Connect with only the release notes metadata.
    release_notes_metadata_path = Dir.mktmpdir("cardslearner-release-notes")
    begin
      upload_to_app_store(
        api_key: api_key,
        reject_if_possible: true,
        submit_for_review: true,
        automatic_release: true,
        skip_metadata: false,
        metadata_path: release_notes_metadata_path,
        release_notes: APP_STORE_RELEASE_NOTES,
        skip_screenshots: true,
        force: true, # Skips HTML report verification
        precheck_include_in_app_purchases: false,
        submission_information: {
          add_id_info_uses_idfa: true,
          add_id_info_serves_ads: true,
          add_id_info_tracks_install: true,
          add_id_info_tracks_action: false,
          add_id_info_limits_tracking: true,
          export_compliance_encryption_updated: false
        }
      )
    ensure
      FileUtils.remove_entry(release_notes_metadata_path) if File.directory?(release_notes_metadata_path)
    end
  end

  desc "Submit the already uploaded IPA to App Review"
  lane :submit_uploaded_build do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")
    )

    release_notes_metadata_path = Dir.mktmpdir("cardslearner-release-notes")
    begin
      upload_to_app_store(
        api_key: api_key,
        ipa: "Learner.ipa",
        skip_binary_upload: true,
        skip_app_version_update: true,
        submit_for_review: true,
        automatic_release: true,
        skip_metadata: false,
        metadata_path: release_notes_metadata_path,
        release_notes: APP_STORE_RELEASE_NOTES,
        force: true,
        skip_screenshots: true,
        precheck_include_in_app_purchases: false,
        submission_information: {
          add_id_info_uses_idfa: true,
          add_id_info_serves_ads: true,
          add_id_info_tracks_install: true,
          add_id_info_tracks_action: false,
          add_id_info_limits_tracking: true,
          export_compliance_encryption_updated: false
        }
      )
    ensure
      FileUtils.remove_entry(release_notes_metadata_path) if File.directory?(release_notes_metadata_path)
    end
  end
end
